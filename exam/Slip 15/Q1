public class ReverseNumber
{
    public static void main(String args[])
    {
        if(args.length == 0)
        {
            System.out.println("Please enter a number");
            return;
        }

        int n = Integer.parseInt(args[0]);
        int reverse = 0;

        while(n != 0)
        {
            int digit = n % 10;
            reverse = reverse * 10 + digit;
            n = n / 10;
        }

        System.out.println("Reversed Number: " + reverse);
    }
}