import game.Indoor;
import game.Outdoor;

public class GameDemo
{
    public static void main(String args[])
    {
        Indoor i1 = new Indoor();
        Indoor i2 = new Indoor("Carrom", "Rohit");

        Outdoor o1 = new Outdoor();
        Outdoor o2 = new Outdoor("Football", "Akash");

        System.out.println("Indoor Players:");
        i1.display();
        i2.display();

        System.out.println();

        System.out.println("Outdoor Players:");
        o1.display();
        o2.display();
    }
}