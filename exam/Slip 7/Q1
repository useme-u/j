File 1 Indoor.java

package game;

public class Indoor
{
    String gameName;
    String playerName;

    public Indoor()
    {
        gameName = "Chess";
        playerName = "Rahul";
    }

    public Indoor(String gameName, String playerName)
    {
        this.gameName = gameName;
        this.playerName = playerName;
    }

    public void display()
    {
        System.out.println("Indoor Game: " + gameName);
        System.out.println("Player Name: " + playerName);
    }
}



